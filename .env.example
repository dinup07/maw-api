# MAW local configuration. `make setup` copies this to .env (which git ignores).
# Everything is optional: without any keys MAW runs on the scripted model and the mock services.
# Values here never override variables already set in your shell.

# --- LLM / embedding provider keys ---------------------------------------------------------------
# These are API keys, not app subscriptions (ChatGPT Plus / Gemini Advanced don't include API use).
#   OpenAI: https://platform.openai.com/api-keys
#   Gemini: https://aistudio.google.com/apikey   (has a free tier)
# Uncomment and fill in the ones you have:
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# --- Local services (started by `make services`) -----------------------------------------------
# Postgres + pgvector from docker-compose.dev.yml. Gives durable runs and the internal vector store.
# Comment out to run fully in memory (nothing survives a restart; RAG on pgvector is unavailable).
MAW_DATABASE_URL=postgresql://maw:maw@127.0.0.1:55432/maw
# Mock MCP server and A2A agent, referenced from config/connections.yaml.
KB_MCP_URL=http://127.0.0.1:8001/mcp
BILLING_AGENT_URL=http://127.0.0.1:9001
# Qdrant (`make qdrant`), for an external vector store you add to config/connections.yaml.
QDRANT_URL=http://127.0.0.1:6333

# --- Server ---------------------------------------------------------------------------------------
MAW_LOG_JSON=false                 # human-readable logs locally; JSON in production
# MAW_LOG_LEVEL=INFO
# MAW_PORT=8000
# MAW_PUBLIC_URL=http://localhost:8000   # base URL written into A2A agent cards
# MAW_API_KEYS=["change-me"]             # enables API-key auth (X-API-Key or Bearer)
# MAW_ALLOW_WORKFLOW_REGISTRATION=true

# --- Secrets for workflows ------------------------------------------------------------------------
# A workflow can read a secret only as ${secret:NAME}, which maps to MAW_SECRET_NAME.
# MAW_SECRET_QDRANT_API_KEY=...
# MAW_SECRET_GITHUB_TOKEN=ghp_...

# --- Security (development defaults shown; production mode enforces safe values) ------------------
# MAW_ENV=development                    # "production" refuses to start with unsafe settings
# MAW_ALLOWED_OUTBOUND_HOSTS=["*"]       # in production list hosts, e.g. ["api.openai.com","generativelanguage.googleapis.com"]
# MAW_ALLOW_INLINE_API_KEYS=false

# --- Tracing (optional) ---------------------------------------------------------------------------
# MAW_TRACING_ENABLED=true
# Jaeger (docker compose --profile tracing up -d jaeger), UI on http://localhost:16686:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Langfuse:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>

# --- Live tests (`make live-test`) ------------------------------------------------------------------
# MAW_LIVE_OPENAI_MODEL=gpt-4o-mini
# MAW_LIVE_GEMINI_MODEL=gemini-2.5-flash

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make validate)",
      "Bash(make test)",
      "Bash(make test-all)",
      "Bash(make smoke)",
      "Bash(make services)",
      "Bash(make db)",
      "Bash(make mocks)",
      "Bash(make stop-mocks)",
      "Bash(make qdrant)",
      "Bash(make ingest:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run maw validate:*)",
      "Bash(uv run maw schema)",
      "Bash(uv sync)",
      "Bash(curl -s localhost:8000/:*)",
      "Bash(curl -s http://localhost:8000/:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)"
    ]
  }
}
